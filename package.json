{
  "name": "mc-commander-tooling",
  "private": true,
  "description": "MC_Commander 工作区根：三个包（apps/web · apps/server · apps/schemas）经 npm workspaces 统一安装，根锁文件是依赖的唯一事实源。",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "check:layout": "node tools/check-layout.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "pretest": "npm run build -w apps/schemas"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  }
}
