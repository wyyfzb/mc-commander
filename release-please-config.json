{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "bump-minor-pre-major": true,
  "include-component-in-tag": false,
  "draft": true,
  "force-tag-creation": true,
  "packages": {
    ".": {
      "changelog-path": "/CHANGELOG.md",
      "extra-files": [
        "/mc_manager_web/package.json",
        "/mc_manager_web/package-lock.json",
        "/mc-schemas/package.json",
        "/mc-schemas/package-lock.json",
        "/mc_commander_server/package.json",
        "/mc_commander_server/package-lock.json",
        "/README.md",
        "/mc_commander_server/README.md"
      ]
    }
  }
}
