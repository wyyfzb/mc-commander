# --- 以下为补充的通用排除规则 ---

# 环境变量文件（保留 .env.example 模板）
.env
.env.local
.env.*.local
*.env.local
!.env.example

# 包管理器调试日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.yarn-integrity

# 包管理器缓存目录
.npm/
.pnpm-store/
.yarn/cache/
.yarn/install-state.gz

# 通用缓存
.cache/
.eslintcache
.parcel-cache/

# 测试覆盖率输出
coverage/
.nyc_output/
*.lcov

# 通用构建输出
dist/
out/
node_modules/

# 临时与备份文件
*.tmp
*.bak
*.orig
*.swp
*~

# TypeScript 增量编译信息
*.tsbuildinfo

# SSH 密钥与凭据（防止误提交敏感信息，dartssh2 自动部署相关）
*.pem
*.key
*.ppk
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
id_ecdsa
id_ecdsa.pub
id_dsa
id_dsa.pub
known_hosts
authorized_keys
.ssh/

# 部署运行时生成的文件
server.log
server.pid
*.pid

# 本地开发部署脚本
mc_commander_server/scripts/dev-deploy.sh

# Flutter 自动生成文件（补充）
.flutter-plugins

# 图片与截图（防止误提交本地截图；以下 assets/ 白名单由 git add 显式纳入）
