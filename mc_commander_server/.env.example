# ============================================================
# MC_Commander Server 环境变量样例（与 config.js 全量对齐）
# 复制为 .env 后按需修改；所有变量均有缺省值，仅 API_KEY 必填。
# ============================================================

# 运行模式引导（NODE_ENV）：
#   production  —— 严格错误掩码（不回传底层错误详情）+ 弱 Key 阻断启动
#   development —— X-Debug-Error 响应头携带错误详情辅助排查
# 部署脚本（systemd/pm2/nohup）均已显式注入 NODE_ENV=production；
# 手动部署请自行设置，未设置时按开发态处理。
#NODE_ENV=production

# API 认证密钥（必须修改！留空则服务端无法启动）
# 首次启动自动迁移为哈希存储（.env 中该行被移除并写入 API_KEY_HASH=<sha256hex>，
# 由服务端维护，无需手动管理；两个都缺时服务端拒绝启动）
API_KEY=

# 生产环境弱 Key 豁免开关（NODE_ENV=production 且 Key 弱时阻断启动；
# 仅开发联调时临时使用，生产环境严禁开启）
#ALLOW_WEAK_KEY=

# 首访设密所有权证明（一次性 SETUP_TOKEN，公网部署建议配置）：
# 部署脚本首次部署自动生成；配置后 POST /auth/setup 必须携带
# `Authorization: SetupToken <token>`，校验通过立即作废（内存 + 本行移除，重启同样失效）。
# 未配置 = 不校验（仅建议本机/可信网络使用）；存量部署手动添加本行即可开启
#SETUP_TOKEN=

# 监听地址（公网部署需显式设 0.0.0.0，默认仅本机 127.0.0.1）
HOST=127.0.0.1

# 信任反向代理层数（Express trust proxy）。默认 1 兼容 nginx/CDN 反代，
# 设 0 不信任代理头（req.ip = 直连 IP）。仅影响 req.ip 解析，
# 登录锁定键始终使用直连 IP 不受此值影响
#TRUST_PROXY=1

# 服务端口
PORT=25566

# 服务器数据目录
SERVERS_DIR=./servers

# 实例数据目录
DATA_DIR=./data

# 备份存储目录
BACKUPS_DIR=./backups

# 前端静态产物目录（锚定服务端安装目录，一般无需修改）
#PUBLIC_DIR=./public

# 日志级别 (debug/info/warn/error)
LOG_LEVEL=info

# 认证前 JSON body 上限（body-parser limit 语法；multipart 文件上传走
# multer 独立通道不受此值影响）
#BODY_LIMIT_JSON=1mb

# ── 管理员会话（安全主线） ──────────────────────────────
# 滑动有效期（小时）：每次认证触达续期，默认 7 天
#ADMIN_SESSION_TTL_HOURS=168
# 会话绝对存活期（天）：自创建起超过该天数强制重登（滑动续期不能突破），
# 默认 30 天；设 0 关闭（不建议）
#ADMIN_SESSION_ABSOLUTE_TTL_DAYS=30
# 会话并发上限：新登录挤掉最旧会话，默认 5
#ADMIN_SESSION_MAX_SESSIONS=5
# 登录失败锁定：窗口内最大失败次数 / 锁定时长（毫秒）
#AUTH_LOGIN_MAX_FAILS=10
#AUTH_LOGIN_LOCK_MS=300000

# ── 限流（认证前按 IP 计数） ────────────────────────────
# 限流窗口时间（毫秒）
RATE_LIMIT_WINDOW=60000
# 窗口内最大请求数（默认 240：前端常态轮询 6-8 端点 × 5s ≈ 72-96 req/min，
# 多标签页场景 100 会误伤）
RATE_LIMIT_MAX=240

# ── 备份保留策略（自动清理） ────────────────────────────
# 每实例保留备份数量上限（备份完成时自动清理超出部分）
BACKUP_RETENTION_MAX=10

# 备份最大保留天数（超出自动清理）
BACKUP_RETENTION_DAYS=30

# 面板自身数据备份（SQLite 每日快照至 backups/panel/，还原步骤见 README「备份管理」）
PANEL_BACKUP_ENABLED=true
PANEL_BACKUP_CRON=0 4 * * *
# 面板快照保留策略（缺省继承 BACKUP_RETENTION_MAX / BACKUP_RETENTION_DAYS）
#PANEL_BACKUP_RETENTION_MAX=10
#PANEL_BACKUP_RETENTION_DAYS=30

# 备份/恢复子进程超时上限（毫秒；实际超时按预估规模动态计算，此值为上限）
BACKUP_SPAWN_TIMEOUT_MS=3600000

# 进行中备份/恢复记录卡死判定阈值（毫秒；进程崩溃后超过此时间自动重置）
BACKUP_IN_PROGRESS_TIMEOUT_MS=3600000

# ── 增量表保留清理（审计日志 / Webhook 投递记录 / 命令历史只增不删，长期运行会拖慢查询）──
# 总开关与调度（服务启动时先执行一次，此后按 cron 周期清理）
RETENTION_PRUNE_ENABLED=true
RETENTION_PRUNE_CRON=30 4 * * *
# 各类记录保留天数（缺省沿用 model 签名值）
#AUDIT_LOG_RETENTION_DAYS=90
#WEBHOOK_DELIVERY_RETENTION_DAYS=30
#COMMAND_HISTORY_RETENTION_DAYS=90

# ── 稳定性 ─────────────────────────────────────────────
# 崩溃循环熔断：滑动窗口（毫秒）内连续崩溃达阈值自动禁用 autoRestart
#CRASH_LOOP_WINDOW_MS=300000
#CRASH_LOOP_MAX_CRASHES=5

# 磁盘使用率告警阈值（百分比）
#DISK_WARNING_PERCENT=85
#DISK_ERROR_PERCENT=95

# 面板重启后自动恢复实例间隔（毫秒）
#AUTO_START_DELAY_MS=3000
