# API 认证密钥（必须修改！留空则服务端无法启动）
API_KEY=

# 服务端口
PORT=25566

# 服务器数据目录
SERVERS_DIR=./servers

# 实例数据目录
DATA_DIR=./data

# 备份存储目录
BACKUPS_DIR=./backups

# 每实例保留备份数量上限（备份完成时自动清理超出部分）
BACKUP_RETENTION_MAX=10

# 备份最大保留天数（超出自动清理）
BACKUP_RETENTION_DAYS=30

# 面板自身数据备份（SQLite 每日快照至 backups/panel/，恢复步骤见 docs/decisions/ADR-0005）
PANEL_BACKUP_ENABLED=true
PANEL_BACKUP_CRON=0 4 * * *
# 面板快照保留策略（缺省继承 BACKUP_RETENTION_MAX / BACKUP_RETENTION_DAYS）
#PANEL_BACKUP_RETENTION_MAX=10
#PANEL_BACKUP_RETENTION_DAYS=30

# 备份/恢复子进程超时上限（毫秒；实际超时按预估规模动态计算，此值为上限）
BACKUP_SPAWN_TIMEOUT_MS=3600000

# 进行中备份/恢复记录卡死判定阈值（毫秒；进程崩溃后超过此时间自动重置）
BACKUP_IN_PROGRESS_TIMEOUT_MS=3600000

# 日志级别 (debug/info/warn/error)
LOG_LEVEL=info

# 限流窗口时间（毫秒）
RATE_LIMIT_WINDOW=60000

# 窗口内最大请求数
RATE_LIMIT_MAX=100
