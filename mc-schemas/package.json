{
  "name": "@mc-commander/schemas",
  "version": "1.2.1",
  "description": "Shared zod schemas for API/WS/notification contracts",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rolldown src/index.ts --format esm --file dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "rolldown": "^1.2.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "license": "AGPL-3.0-or-later"
}
